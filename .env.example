# eBay application keys (developer.ebay.com -> Application Keysets).
# The Browse and Taxonomy APIs both run off the client-credentials grant, so
# there is no user-consent flow to set up.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
EBAY_MARKETPLACE_ID=EBAY_US
# api.sandbox.ebay.com while you are wiring things up.
EBAY_API_HOST=api.ebay.com

ANTHROPIC_API_KEY=
POKEHUNT_VISION_MODEL=claude-sonnet-5

# Optional. Raises the pokemontcg.io rate limit; the API works without it.
POKEMONTCG_API_KEY=

DISCORD_WEBHOOK_URL=

# Hunt criteria
POKEHUNT_ENDING_WITHIN_HOURS=24
POKEHUNT_MAX_WATCHERS=3
POKEHUNT_MAX_SELLER_FEEDBACK=100
POKEHUNT_MIN_SELLER_FEEDBACK_PCT=90
POKEHUNT_MAX_CURRENT_PRICE=400
# allow | skip -- what to do when eBay does not report a watch count.
POKEHUNT_UNKNOWN_WATCHERS=allow

# Anything below this confidence gets a red flag in the alert.
POKEHUNT_CONFIDENCE_THRESHOLD=0.70

# Spend control: hard cap on vision calls per scan, and photos per listing.
POKEHUNT_MAX_VISION_CALLS=40
POKEHUNT_MAX_IMAGES=8

POKEHUNT_DB=pokehunt.db
POKEHUNT_CACHE_DIR=.pokehunt-cache
